# Copy this file to .env and fill in real values before running the app.
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────
# Either set DATABASE_URL (e.g. for a hosted Postgres like Supabase/Railway/RDS)…
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true
#
# …or set these individually for a local/self-managed Postgres:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gazva_insight
DB_USER=gazva
DB_PASSWORD=change-me

# ── Auth ──────────────────────────────────────────────────────────────────
# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRES_HOURS=12

# Set true only once the site is served over HTTPS (production).
COOKIE_SECURE=false

# First admin account — created automatically the first time you run
# "npm run db:seed" (or "npm run admin:create" to add one interactively).
# Remove these two lines from .env after the first admin is created.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password-min-10-chars
ADMIN_NAME=Admin

# ── Site ──────────────────────────────────────────────────────────────────
# Used for absolute URLs in social-share meta tags. Set in production.
SITE_URL=
# Your deployed frontend origin, if served separately from the API (CSRF check).
CLIENT_ORIGIN=

# ── Uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ── Email notifications for new messages (optional) ────────────────────────
# Leave SMTP_HOST blank to disable; messages still save to the database either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
